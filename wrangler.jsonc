{
  // Cloudflare deploy config. The Worker (`main`) serves /api/* (cloud sync); everything else is
  // served from dist/ as a local-first SPA. `run_worker_first: ["/api/*"]` means only API paths
  // invoke the Worker — static assets are served directly, with SPA fallback for unknown routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writers-codex",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "writers-codex",
      "database_id": "f7eed447-f63a-4727-8377-2416258eea42",
      "migrations_dir": "migrations"
    }
  ],
  // Photo storage. Binding a bucket that does not exist fails the WHOLE deploy, so the bucket has to
  // be created before the first deploy that carries this line:
  //   npx wrangler r2 bucket create writers-codex-images
  // Photos live here (a 640px thumbnail and a 2000px full size per entity); D1 holds only the
  // metadata row that tells other devices a photo exists. See worker/images.ts.
  //
  // ONE binding only. `wrangler r2 bucket create` offers to add a second entry named after the
  // bucket (writers_codex_images); that was declined and removed. worker/index.ts reads c.env.IMAGES,
  // so a second binding to the same bucket would be dead weight that future readers have to puzzle out.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "writers-codex-images" }]
}
