{
  // Cloudflare deploy config. The Worker (`main`) serves /api/* (cloud sync); everything else is
  // served from dist/ as a local-first SPA. `run_worker_first: ["/api/*"]` means only API paths
  // invoke the Worker — static assets are served directly, with SPA fallback for unknown routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writers-codex",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "writers-codex",
      "database_id": "f7eed447-f63a-4727-8377-2416258eea42",
      "migrations_dir": "migrations"
    }
  ]
  // R2 (photo sync) is DISABLED until the account has R2 enabled (needs a payment card on file) and
  // the bucket exists — binding a nonexistent bucket fails the whole deploy. To enable: create the
  // bucket (`npx wrangler r2 bucket create writers-codex-images`), then restore:
  // "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "writers-codex-images" }]
}
