{
  "name": "writers-codex",
  "version": "0.1.0",
  "description": "Writer's Codex — a local-first, offline, installable writing & worldbuilding organizer.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sample && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:api": "wrangler dev",
    "build:sample": "node scripts/build-sample.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.108.0"
  },
  "dependencies": {
    "hono": "^4.12.29",
    "idb": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
